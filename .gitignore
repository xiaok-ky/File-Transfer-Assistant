# ============ 运行时数据（**绝对不要提交**）============
# 里面有你的访问 token、设备编号、传输记录和收到的文件
data/
*/data/
**/data/

# ============ 打包产物 ============
dist/
dist_gui/
build/
build_gui/
*.zip
*.exe
*.manifest

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/

# ============ 构建依赖缓存 ============
_builddeps/

# ============ 测试临时目录（名字以下划线开头）============
_*/
!__init__.py

